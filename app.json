{
  "expo": {
    "name": "Timeless Frequencies",
    "slug": "timeless-frequencies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/timeless-frequencies-logo.png",
    "scheme": "timelessfrequencies",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.timelessfrequencies.app",
      "versionCode": 1,
      "backgroundColor": "#100C0A",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#100C0A",
        "foregroundImage": "./assets/branding/timeless-frequencies-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100C0A",
          "image": "./assets/branding/timeless-frequencies-logo.png",
          "imageWidth": 200
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1dd1d6b6-babb-481e-a87f-8604148292c7"
      }
    }
  }
}
